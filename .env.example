# Postgres (Neon/Supabase free tier)
DATABASE_URL=postgres://user:password@host:5432/job_hunter

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apify (job-source scrapers — SPEC.md Part 3)
APIFY_TOKEN=
# Actor IDs are configurable per SPEC.md Part 5 (actor availability/maintenance varies).
# Pick a maintained actor for each source and set its id here.
APIFY_ALLJOBS_ACTOR_ID=
APIFY_DRUSHIM_ACTOR_ID=
APIFY_INDEED_IL_ACTOR_ID=
APIFY_LINKEDIN_ACTOR_ID=

# Bounded per source per search (SPEC.md Part 5 — Apify is pay-per-result).
APIFY_RESULTS_PER_SOURCE=5

# OpenRouter (skills-fit AI scoring only — SPEC.md Part 3)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
