{
  "components": {
    "schemas": {
      "BoardResult": {
        "additionalProperties": false,
        "properties": {
          "board": {
            "title": "Board",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "listings": {
            "title": "Listings",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "empty",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "board",
          "status",
          "listings"
        ],
        "title": "BoardResult",
        "type": "object"
      },
      "Family": {
        "additionalProperties": false,
        "properties": {
          "en": {
            "title": "En",
            "type": "string"
          },
          "he": {
            "title": "He",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "en",
          "he",
          "roles"
        ],
        "title": "Family",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ListingResult": {
        "additionalProperties": false,
        "properties": {
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "listing_id": {
            "title": "Listing Id",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "overall_score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Overall Score",
            "type": "integer"
          },
          "partial_text": {
            "title": "Partial Text",
            "type": "boolean"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ResultPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "posted_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posted At"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "sub_scores": {
            "$ref": "#/components/schemas/SubScores"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Shown above the gaps when nothing matched (criterion 5).",
            "title": "Summary"
          },
          "text": {
            "description": "The full listing text the quotes come from.",
            "title": "Text",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "listing_id",
          "source",
          "url",
          "title",
          "company",
          "location",
          "posted_at",
          "text",
          "partial_text",
          "overall_score",
          "sub_scores",
          "points"
        ],
        "title": "ListingResult",
        "type": "object"
      },
      "ResultPoint": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "title": "Claim",
            "type": "string"
          },
          "kind": {
            "enum": [
              "matched",
              "gap"
            ],
            "title": "Kind",
            "type": "string"
          },
          "origin": {
            "enum": [
              "deterministic",
              "ai"
            ],
            "title": "Origin",
            "type": "string"
          },
          "quote": {
            "description": "Verbatim substring of the listing text (SPEC criterion 5).",
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "claim",
          "quote",
          "origin"
        ],
        "title": "ResultPoint",
        "type": "object"
      },
      "Role": {
        "additionalProperties": false,
        "properties": {
          "en": {
            "title": "En",
            "type": "string"
          },
          "generic": {
            "default": false,
            "description": "A title naming only this role is too broad to decide the occupation (\"Software Engineer\", \"Technician\"), so the listing body is read as well.",
            "title": "Generic",
            "type": "boolean"
          },
          "he": {
            "title": "He",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "synonyms": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Synonyms",
            "type": "array"
          }
        },
        "required": [
          "id",
          "en",
          "he"
        ],
        "title": "Role",
        "type": "object"
      },
      "SearchResults": {
        "additionalProperties": false,
        "properties": {
          "boards": {
            "items": {
              "$ref": "#/components/schemas/BoardResult"
            },
            "title": "Boards",
            "type": "array"
          },
          "demo": {
            "default": false,
            "description": "Recorded listings scored without the AI step, for show.",
            "title": "Demo",
            "type": "boolean"
          },
          "results": {
            "description": "Best score first (criterion 4).",
            "items": {
              "$ref": "#/components/schemas/ListingResult"
            },
            "title": "Results",
            "type": "array"
          },
          "search": {
            "$ref": "#/components/schemas/SearchSummary"
          },
          "version": {
            "default": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "search",
          "boards",
          "results"
        ],
        "title": "SearchResults",
        "type": "object"
      },
      "SearchSummary": {
        "additionalProperties": false,
        "properties": {
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "keyword": {
            "title": "Keyword",
            "type": "string"
          },
          "levels": {
            "items": {
              "type": "string"
            },
            "title": "Levels",
            "type": "array"
          },
          "occupations": {
            "items": {
              "type": "string"
            },
            "title": "Occupations",
            "type": "array"
          }
        },
        "required": [
          "keyword",
          "city",
          "occupations",
          "levels"
        ],
        "title": "SearchSummary",
        "type": "object"
      },
      "SubScores": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Location",
            "type": "integer"
          },
          "occupation": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Occupation",
            "type": "integer"
          },
          "seniority": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Seniority",
            "type": "integer"
          },
          "skills": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "None when the AI step failed or didn't run.",
            "title": "Skills"
          }
        },
        "required": [
          "location",
          "occupation",
          "seniority"
        ],
        "title": "SubScores",
        "type": "object"
      },
      "Taxonomy": {
        "additionalProperties": false,
        "properties": {
          "families": {
            "items": {
              "$ref": "#/components/schemas/Family"
            },
            "title": "Families",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "families"
        ],
        "title": "Taxonomy",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Job Hunter API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness plus database reachability. The service stays up when the database is down,\nso the problem is visible here instead of as a crash loop.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/occupations": {
      "get": {
        "description": "The whole occupation taxonomy, for the search bar to filter on every keystroke\nwithout calling the server again (SPEC criterion 28).",
        "operationId": "list_occupations_api_occupations_get",
        "parameters": [
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Taxonomy"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Occupations",
        "tags": [
          "occupations"
        ]
      }
    },
    "/api/searches/demo": {
      "get": {
        "description": "A sample search on real recorded listings, scored without the AI step. Free to call:\nno board or LLM is contacted.",
        "operationId": "demo_results_api_searches_demo_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Demo Results",
        "tags": [
          "searches"
        ]
      }
    }
  }
}
