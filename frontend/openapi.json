{
  "components": {
    "schemas": {
      "Family": {
        "additionalProperties": false,
        "properties": {
          "en": {
            "title": "En",
            "type": "string"
          },
          "he": {
            "title": "He",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "id",
          "en",
          "he",
          "roles"
        ],
        "title": "Family",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Role": {
        "additionalProperties": false,
        "properties": {
          "en": {
            "title": "En",
            "type": "string"
          },
          "generic": {
            "default": false,
            "description": "A title naming only this role is too broad to decide the occupation (\"Software Engineer\", \"Technician\"), so the listing body is read as well.",
            "title": "Generic",
            "type": "boolean"
          },
          "he": {
            "title": "He",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "synonyms": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Synonyms",
            "type": "array"
          }
        },
        "required": [
          "id",
          "en",
          "he"
        ],
        "title": "Role",
        "type": "object"
      },
      "Taxonomy": {
        "additionalProperties": false,
        "properties": {
          "families": {
            "items": {
              "$ref": "#/components/schemas/Family"
            },
            "title": "Families",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "families"
        ],
        "title": "Taxonomy",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Job Hunter API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness plus database reachability. The service stays up when the database is down,\nso the problem is visible here instead of as a crash loop.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/occupations": {
      "get": {
        "description": "The whole occupation taxonomy, for the search bar to filter on every keystroke\nwithout calling the server again (SPEC criterion 28).",
        "operationId": "list_occupations_api_occupations_get",
        "parameters": [
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Taxonomy"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Occupations",
        "tags": [
          "occupations"
        ]
      }
    }
  }
}
